<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-8">
      <div class="sj-card text-center py-5 px-4 mb-4">
        <div class="d-flex justify-content-center align-items-center mb-3">
          <span class="h6 fw-bold sj-text-main mb-0"><%= station.name %></span>
          <span id="streamStatusBadge" class="badge bg-secondary ms-2">
            <%= station.is_live ? "STREAMING LIVE" : "OFFLINE" %>
          </span>
        </div>

        <div class="d-flex justify-content-center mb-4">
          <img id="nowPlayingArt" src="" class="sj-cover-art-lg shadow d-none" alt="Cover Art">
          <div id="nowPlayingPlaceholder" class="sj-cover-art-placeholder shadow">
            <span>Live Radio</span>
          </div>
        </div>

        <h1 id="nowPlayingTitle" class="h3 fw-bold sj-text-main mb-1">Live Broadcast</h1>
        <div id="nowPlayingArtist" class="sj-accent-color fw-semibold mb-1">Tuned into <%= station.name %></div>
        <div id="nowPlayingAlbum" class="small sj-text-muted mb-4"></div>

        <div id="upNextContainer" class="d-none mb-4">
          <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill sj-bg-surface sj-border">
            <span class="badge bg-secondary">Up Next</span>
            <span id="upNextTrack" class="small fw-semibold sj-text-main"></span>
          </div>
        </div>

        <div id="waveformContainer" class="d-flex justify-content-center align-items-center mb-4 d-none">
          <div class="sj-waveform-bar"></div>
          <div class="sj-waveform-bar"></div>
          <div class="sj-waveform-bar"></div>
          <div class="sj-waveform-bar"></div>
          <div class="sj-waveform-bar"></div>
        </div>

        <div class="row justify-content-center mb-4">
          <div class="col-12 col-md-8">
            <div id="streamOfflineAlert" class="alert alert-warning py-2 px-3 small d-none mb-3" role="alert">
              <span id="streamOfflineMessage">ดีเจยังไม่ออนไลน์ในขณะนี้ กรุณารอสักครู่หรือกลับมาใหม่อีกครั้ง</span>
            </div>
            <button id="btnPlayStream" class="btn sj-btn-accent btn-lg w-100 py-3">
              <span>▶ Listen Live Stream</span>
            </button>
          </div>
        </div>

        <div class="row justify-content-center">
          <div class="col-10 col-md-6 d-flex align-items-center gap-2">
            <span class="small sj-text-muted">🔈</span>
            <input type="range" class="form-range" id="volumeSlider" min="0" max="1" step="0.05" value="1">
            <span class="small sj-text-muted">🔊</span>
          </div>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-12 col-md-6">
          <div class="sj-card h-100">
            <span class="small text-uppercase fw-bold sj-text-muted d-block mb-3">Request a Song</span>

            <div id="requestSuccessAlert" class="alert alert-success py-2 small d-none mb-3">
              Song request submitted to the DJ!
            </div>

            <div class="mb-3">
              <label class="form-label small sj-text-main">Your Nickname</label>
              <input type="text" id="requesterNameInput" class="form-control form-control-sm" placeholder="e.g. Alex">
            </div>

            <div class="mb-3">
              <label class="form-label small sj-text-main">Search Track</label>
              <div class="input-group input-group-sm">
                <input type="text" id="requestSearchInput" class="form-control" placeholder="Search track or artist...">
                <button id="btnRequestSearch" class="btn sj-btn-accent">Search</button>
              </div>
            </div>

            <div id="requestSearchResults" class="sj-panel-scroll"></div>
          </div>
        </div>

        <div class="col-12 col-md-6">
          <div class="sj-card h-100 d-flex flex-column">
            <span class="small text-uppercase fw-bold sj-text-muted d-block mb-3">Live Station Chat</span>

            <div id="chatMessages" class="sj-chat-scroll flex-grow-1 mb-3"></div>

            <div class="mb-2">
              <input type="text" id="chatSenderName" class="form-control form-control-sm" placeholder="Your Name">
            </div>
            <div class="input-group input-group-sm">
              <input type="text" id="chatInput" class="form-control" placeholder="Type a message...">
              <button id="btnSendChat" class="btn sj-btn-accent">Send</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  window.STATION_SLUG = "<%= station.slug %>";
  window.BACKEND_WS_URL = "<%= backendPublicUrl.replace(/^http/, 'ws') %>/ws";
  window.STATION_PALETTE = <%- JSON.stringify(station.palette_config || {}).replace(/</g, '\\u003c').replace(/>/g, '\\u003e') %>;
</script>
<script type="module" src="/js/listener.js?v=<%= Date.now() %>"></script>
