<div class="container py-5">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 fw-bold sj-text-main mb-1">Radio Broadcast Stations</h1>
      <p class="sj-text-muted mb-0">Select an existing station or create a new live broadcast.</p>
    </div>
    <button class="btn sj-btn-accent px-4 py-2 mt-2 mt-md-0" data-bs-toggle="modal" data-bs-target="#modalCreateStation">
      + Create Station
    </button>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger py-2 mb-4">
      <%= error %>
    </div>
  <% } %>

  <div class="row g-4">
    <% if (stations.length === 0) { %>
      <div class="col-12">
        <div class="sj-card text-center py-5">
          <p class="sj-text-muted mb-3">No stations found yet.</p>
          <button class="btn sj-btn-accent" data-bs-toggle="modal" data-bs-target="#modalCreateStation">
            Create First Station
          </button>
        </div>
      </div>
    <% } else { %>
      <% stations.forEach(st => { %>
        <div class="col-12 col-md-6 col-lg-4">
          <div class="sj-card h-100 d-flex flex-column justify-content-between">
            <div>
              <div class="d-flex justify-content-between align-items-start mb-2">
                <h2 class="h5 fw-bold sj-text-main mb-0"><%= st.name %></h2>
                <% if (st.is_live) { %>
                  <span class="sj-badge-live small">
                    <span class="sj-pulse-dot me-1"></span> LIVE
                  </span>
                <% } else { %>
                  <span class="badge bg-secondary small">OFFLINE</span>
                <% } %>
              </div>
              <div class="small sj-accent-color mb-2">/<%= st.slug %></div>
              <p class="sj-text-muted small mb-4">
                <%= st.description || "No description provided." %>
              </p>
            </div>

            <div class="pt-3 sj-border-top">
              <div class="d-flex gap-2">
                <a href="/live/<%= st.slug %>" class="btn sj-btn-accent flex-grow-1">
                  Listen Live
                </a>
                <a href="/studio/<%= st.slug %>" class="btn sj-btn-outline">
                  DJ Studio
                </a>
                <a href="/settings/<%= st.slug %>" class="btn sj-btn-outline">
                  ⚙
                </a>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>

<div class="modal fade" id="modalCreateStation" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content sj-bg-surface sj-border">
      <form action="/stations/create" method="POST">
        <div class="modal-header sj-border-bottom">
          <h5 class="modal-title sj-text-main">Create New Station</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label sj-text-main">Station Name</label>
            <input type="text" name="name" class="form-control" placeholder="e.g. Midnight Beats" required>
          </div>
          <div class="mb-3">
            <label class="form-label sj-text-main">Slug (URL)</label>
            <input type="text" name="slug" class="form-control" placeholder="e.g. midnight-beats" required pattern="[a-z0-9-]+">
          </div>
          <div class="mb-3">
            <label class="form-label sj-text-main">DJ Passcode</label>
            <input type="password" name="passcode" class="form-control" placeholder="Leave blank to auto-generate (min 4 chars)" minlength="4">
            <div class="form-text sj-text-muted small">Required to unlock DJ Studio console for broadcasting.</div>
          </div>
          <div class="mb-3">
            <label class="form-label sj-text-main">Description</label>
            <textarea name="description" class="form-control" rows="3" placeholder="Brief introduction to your station"></textarea>
          </div>
        </div>
        <div class="modal-footer sj-border-top">
          <button type="button" class="btn sj-btn-outline" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn sj-btn-accent">Create Station</button>
        </div>
      </form>
    </div>
  </div>
</div>
